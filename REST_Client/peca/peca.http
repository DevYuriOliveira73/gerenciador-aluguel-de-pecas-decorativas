@baseUrl = http://localhost:3001/api
@categoria_id = 1
@peca_id = 1


### =========================================
### POST - Criar PEÇA
### =========================================
POST {{baseUrl}}/pecas
Content-Type: application/json

{
  "nome": "Bandeja yuri",
  "descricao": "Mesa redonda branca, 8 lugares",
  "quantidade": 10,
  "categoria_id": {{categoria_id}}
}

### =========================================
### GET - pUXAR PECAS
### =========================================
GET  {{baseUrl}}/pecas
Content-Type: application/json


### =========================================
### PATCH - Desativar peca
### =========================================
PATCH  {{baseUrl}}/pecas/{{peca_id}}/desativar
Content-Type: application/json

###############################

### =========================================
### PUT/PATCH - Atualizar PEÇA (Validação com Sucesso)
### =========================================
PATCH {{baseUrl}}/pecas/{{peca_id}}
Content-Type: application/json

{
  "nome": "Bandeja Yuri Editada",
  "quantidade": 7
}

### =========================================
### PUT/PATCH - Atualizar PEÇA (Erro: Nenhum campo enviado)
### =========================================
PATCH {{baseUrl}}/pecas/{{peca_id}}
Content-Type: application/json

{}

### =========================================
### PUT/PATCH - Atualizar PEÇA (Erro: Quantidade inválida)
### =========================================
PATCH {{baseUrl}}/pecas/{{peca_id}}
Content-Type: application/json

{
  "quantidade": -5
}


