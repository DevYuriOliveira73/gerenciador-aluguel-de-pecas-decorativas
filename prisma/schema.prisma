// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Categoria {
  id        Int    @id @default(autoincrement())
  nome      String @unique
  descricao String
  pecas     Peca[]

  createdAt DateTime @default(now())
}

model Peca {
  id           Int       @id @default(autoincrement())
  nome         String
  descricao    String
  quantidade   Int
  categoria    Categoria @relation(fields: [categoria_id], references: [id], onDelete: Restrict)
  categoria_id Int
  // disponivel   Boolean   @default(true) precisa de uma logica para definir se a peça está disponivel ou não
  imagem       String?
  deletedAt DateTime?

  itensAluguel ItemAluguel[]

  createdAt DateTime @default(now())

  @@unique([nome, descricao])
}

model Cliente {
  id        Int       @id @default(autoincrement())
  nome      String
  sobrenome String
  email     String    @unique @db.VarChar(64)
  telefone  String    @db.Char(11)
  alugueis  Aluguel[]

  endereco String

  cpf      String @unique @db.Char(11)
}

model Aluguel {
  id              Int     @id @default(autoincrement())
  cliente         Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  cliente_id      Int

  data_inicio     DateTime
  data_fim        DateTime

  preco           Decimal @db.Decimal(10, 2)

  devolvido       Boolean @default(false) @db.Boolean

  itensAluguel    ItemAluguel[]

  createdAt       DateTime @default(now())
}

model ItemAluguel {
  id            Int     @id @default(autoincrement())
  aluguel       Aluguel @relation(fields: [aluguel_id], references: [id], onDelete: Restrict)
  aluguel_id    Int

  peca          Peca @relation(fields: [peca_id], references: [id], onDelete: Restrict)
  peca_id       Int

  quantidade    Int

  @@unique([aluguel_id, peca_id])
}
