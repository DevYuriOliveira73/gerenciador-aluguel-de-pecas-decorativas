@baseUrl = http://localhost:3001/api
@id_categoria = 2

### =========================================
### POSTS - Criar CATEGORIA
### =========================================
POST {{baseUrl}}/categorias
Content-Type: application/json

{
  "nome" : "Arco",
  "descricao" : "Estrutura circular"
}

### =========================================
### GET - Listar todas
### =========================================
GET {{baseUrl}}/categorias
Content-Type: application/json


### =========================================
### PUT - Editar categoria
### =========================================
PUT {{baseUrl}}/categorias/{{id_categoria}}
Content-Type: application/json

{
  "nome" : "Boleira",
  "descricao" : "[edit] estrutura usada para colocar doces"
}
